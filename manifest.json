{
    "manifest_version":  3,
    "name":  "PokeIdleManager",
    "version":  "1.0.12",
    "key":  "",
    "permissions":  [
                        "storage"
                    ],
    "host_permissions":  [
                             "https://fcigdnmvbaxwyjmyobvn.supabase.co/*",
                             "https://pokeidle.io/*",
                             "https://*.pokeidle.io/*"
                         ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "action":  {
                   "default_popup":  "popup.html"
               },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://pokeidle.io/*",
                                                "https://*.pokeidle.io/*"
                                            ],
                                "js":  [
                                           "content.js"
                                       ],
                                "run_at":  "document_idle"
                            }
                        ],
    "web_accessible_resources":  [
                                     {
                                         "resources":  [
                                                           "bot.js"
                                                       ],
                                         "matches":  [
                                                         "https://pokeidle.io/*",
                                                         "https://*.pokeidle.io/*"
                                                     ]
                                     }
                                 ]
}
