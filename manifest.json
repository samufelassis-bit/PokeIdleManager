{
    "manifest_version":  3,
    "name":  "Pokeidle Bot Manager",
    "description":  "Automação para o PokeIdle: Auto Hunt, compra automática de poções, bolas e revives e ordem de uso dos itens.",
    "version": "2.2.1",
    "key":  "",
    "update_url":  "https://clients2.google.com/service/update2/crx",
    "icons":  {
                  "16":  "icons/icon-16.png",
                  "32":  "icons/icon-32.png",
                  "48":  "icons/icon-48.png",
                  "128":  "icons/icon-128.png"
              },
    "action":  {
                   "default_popup":  "popup.html",
                   "default_icon":  { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
               },
    "background":  {
                       "service_worker":  "background.js"
                   },
    "permissions":  [
                        "storage",
                        "alarms"
                    ],
    "host_permissions":  [
                             "https://fcigdnmvbaxwyjmyobvn.supabase.co/*",
                             "https://pokeidle.io/*",
                             "https://*.pokeidle.io/*"
                         ],
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://pokeidle.io/*",
                                                "https://*.pokeidle.io/*"
                                            ],
                                "js":  [
                                           "content.js"
                                       ],
                                "run_at":  "document_idle"
                            }
                        ],
    "web_accessible_resources":  [
                                     {
                                         "matches":  [
                                                         "https://pokeidle.io/*",
                                                         "https://*.pokeidle.io/*"
                                                     ],
                                         "resources":  [
                                                           "bot.js"
                                                       ]
                                     }
                                 ]
}
